# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Database ----
DATABASE_URL=postgresql://maaya:maaya_dev_password@localhost:5432/maaya_dev?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Customer auth — Better Auth (placeholders — rotate before real use, never commit real secrets) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32+char-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Optional — leave unset to keep Google sign-in disabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Separate credential space for staff/admin auth (Step 6 of the architecture doc, Milestone 8)
JWT_ADMIN_ACCESS_SECRET=replace-with-a-third-32+char-random-secret
JWT_ADMIN_EXPIRES_IN=15m

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
