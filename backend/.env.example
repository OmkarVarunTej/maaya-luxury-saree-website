# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Database ----
DATABASE_URL=postgresql://maaya:maaya_dev_password@localhost:5432/maaya_dev?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth (placeholders — rotate before real use, never commit real secrets) ----
JWT_ACCESS_SECRET=replace-with-32+char-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-32+char-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# Separate audience/secret for staff/admin auth (Step 6 of the architecture doc)
JWT_ADMIN_ACCESS_SECRET=replace-with-a-third-32+char-random-secret
JWT_ADMIN_EXPIRES_IN=15m

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
